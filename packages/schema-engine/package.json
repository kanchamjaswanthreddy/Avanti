{
  "name": "@avanti/schema-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types":   "./dist/index.d.ts",
      "import":  "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./diff": {
      "types":   "./dist/diff.d.ts",
      "import":  "./dist/diff.js",
      "default": "./src/diff.ts"
    }
  },
  "scripts": {
    "build":     "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@avanti/types": "*",
    "@avanti/utils": "*",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg":   "^8.11.0",
    "typescript":  "^5.7.0"
  }
}
