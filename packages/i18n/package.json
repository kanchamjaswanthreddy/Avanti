{
  "name": "@avanti/i18n",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types":   "./dist/index.d.ts",
      "import":  "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./messages/*": "./src/messages/*.json"
  },
  "scripts": {
    "build":     "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next-intl": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript":  "^5.7.0"
  }
}
