{
  "name": "vidyut",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "docker compose up -d && npx turbo dev",
    "dev:stop": "docker compose down",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:reset": "docker compose down -v && docker compose up -d postgres redis && sleep 3 && npx tsx tools/migrate.ts --env=local --reset",
    "migrate": "npx tsx tools/migrate.ts",
    "deploy:production": "turbo build && npx tsx tools/migrate.ts --env=production",
    "deploy:api": "turbo build --filter=@vidyut/api",
    "provision:local": "npx tsx tools/provision-local.ts"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0"
  },
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22.0.0"
  }
}
