# ─────────────────────────────────────────────────────────────
# Vidyut — Environment Variables Reference
# Copy to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────

# ── Control Plane Database (local Docker) ────────────────────
CONTROL_PLANE_DB_URL=postgresql://dev_user:dev_password@localhost:5434/vidyut_control

# ── Redis (local Docker) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ──────────────────────────────────────────────────────
# Use a long random string in production. NEVER use this value in prod.
JWT_SECRET=dev-jwt-secret-minimum-32-chars-change-in-production

# ── AI (Claude API) ──────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Voice (Sarvam AI) ────────────────────────────────────────
SARVAM_API_KEY=...

# ── GCP (only needed for production deploy) ──────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-south1
# Path to service account key JSON — see docs/OperationsDesignReference_v1.docx Section 8.7
GOOGLE_APPLICATION_CREDENTIALS=~/.config/gcloud/application_default_credentials.json

# ── Email (local Mailpit catches all outgoing mail) ──────────
SMTP_HOST=localhost
SMTP_PORT=1025

# ── App URLs ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# ── Misc ─────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
